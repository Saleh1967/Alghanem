def diacritics : List Char := ['َ', 'ُ', 'ِ', 'ّ']
def bare (s : String) : List Char := s.data.filter (fun c => !(diacritics.contains c))
def isVowel (c : Char) : Bool := c == 'َ' || c == 'ُ' || c == 'ِ'
def longV (c : Char) : Bool := c == 'ا' || c == 'و' || c == 'ي'
def augment (c : Char) : Bool := c == 'م' || c == 'أ' || c == 'ت'

/-- F: القانون الواحد على «أربع خانات»: C1 a C2 aa C3 (i|ii) C4، والطول الأخير موروث. -/
def F (sing : String) : Option String :=
  match bare sing with
  | [p, 'ف', 'ع', 'ل'] => if augment p then some (String.mk [p, 'َ'] ++ "فَاعِل") else none
  | [p, 'ف', 'ع', v, 'ل'] =>
      if augment p && longV v then some (String.mk [p, 'َ'] ++ "فَاعِيل") else none
  | ['ف', 'ا', 'ع', 'ل', 'ة'] => some "فَوَاعِل"
  | ['ف', 'ع', v, 'ل', 'ة'] => if longV v then some "فَعَائِل" else none
  | _ => none

/-- F₀: نسخة الاختبار الأولى، تُدخل «فاعِل» المذكّر أيضًا (أُعلنت قبل رؤية النتيجة). -/
def F₀ (sing : String) : Option String :=
  match bare sing with
  | ['ف', 'ا', 'ع', 'ل'] => some "فَوَاعِل"
  | _ => F sing

def inDomain (f : String → Option String) := table.filter (fun (_, a, _) => (f a).isSome)
def hits (f : String → Option String) :=
  (inDomain f).filter (fun (_, a, b) => f a == some b)

/-- F₀ (المعلنة قبل القياس): 22 زوجًا في مجالها، تطابق 18. -/
theorem F0_domain : (inDomain F₀).length = 22 := by decide
theorem F0_hits   : (hits F₀).length = 18 := by decide

/-- F (بعد إخراج «فاعِل» المذكّر؛ سببه: جمعه يتبع العاقل وغير العاقل، وهو معنًى لا تراه القوانين):
    19 زوجًا، تطابق 18؛ الخلاف الوحيد خليفة ← خلفاء. -/
theorem F_domain : (inDomain F).length = 19 := by decide
theorem F_hits   : (hits F).length = 18 := by decide
theorem F_only_miss :
    (inDomain F).filter (fun (_, a, b) => F a != some b) = [("خلف", "فَعِيلَة", "فُعَلَاء")] := by
  decide

/-- خليفة لها الجمعان في المودَع (خلائف وخلفاء): تعدّدٌ مرخَّص لا خطأ. -/
theorem khalifa_two_plurals :
    ("خلف", "فَعِيلَة", "فَعَائِل") ∈ table ∧ ("خلف", "فَعِيلَة", "فُعَلَاء") ∈ table := by decide

/-- قانون الابتداء على الطرف الأيسر: لا صيغة جمع تبدأ بساكن (الحرف الثاني حركةٌ دائمًا). -/
theorem no_plural_starts_with_sukun :
    table.all (fun (_, _, b) => match b.data with
      | _ :: c :: _ => isVowel c
      | _ => false) = true := by decide

/-- وكل صيغة جمع تبدأ بهمزة يليها ساكن: الهمزة إصلاحُ ابتداءٍ لجذعٍ يبدأ بساكن. -/
theorem hamza_plural_before_sukun :
    (table.filter (fun (_, _, b) => b.data.head? == some 'أ')).all
      (fun (_, _, b) => match b.data with
        | _ :: _ :: c :: _ => !isVowel c
        | _ => false) = true := by decide

/-- المفرد الثلاثيّ: لا دالّة في صيغة المفرد وحدها — «فَعل» يُجمع على فِعَال (بحار) وفُعُول (ذنوب). -/
theorem triliteral_not_function :
    ¬ ∃ g : String → String, ∀ t ∈ table, g t.2.1 = t.2.2 := by
  intro ⟨g, hg⟩
  have h1 := hg ("بحر", "فَعل", "فِعَال") (by decide)
  have h2 := hg ("ذنب", "فَعل", "فُعُول") (by decide)
  simp at h1 h2
  rw [h1] at h2
  exact absurd h2 (by decide)

