def diacritics : List Char := ['َ', 'ُ', 'ِ', 'ّ', 'ْ']
def bare (s : String) : String := String.mk (s.data.filter (fun c => !(diacritics.contains c)))

def F (sing : String) : Option String :=
  match (bare sing).data with
  | [p, 'ف', 'ع', 'ل'] => if p == 'م' || p == 'أ' || p == 'ت' then some (String.mk [p] ++ "فاعل") else none
  | [p, 'ف', 'ع', v, 'ل'] =>
      if (p == 'م' || p == 'أ' || p == 'ت') && (v == 'ا' || v == 'و' || v == 'ي')
      then some (String.mk [p] ++ "فاعيل") else none
  | ['ف', 'ا', 'ع', 'ل', 'ة'] => some "فواعل"
  | ['ف', 'ع', v, 'ل', 'ة'] => if v == 'ا' || v == 'و' || v == 'ي' then some "فعائل" else none
  | _ => none

def fHit (r : String × String × String) : Bool := F r.2.1 == some (bare r.2.2)

theorem F_domain : fRows.length = 749 := by decide
theorem F_hits : (fRows.filter fHit).length = 531 := by decide
/-- أكبر الخلاف: أَفْعَل ← فُعْل (154 زوجًا): أفعل الصفة (حُمْر، عُمْي)، وهو صنفُ معنى لا تراه القوانين. -/
theorem F_af3al_sifa :
    (fRows.filter (fun r => bare r.2.1 == "أفعل" && bare r.2.2 == "فعل")).length = 154 := by decide
/-- بعد إخراجه (معلنٌ بعد القياس، وسببه مذكور): 595 زوجًا، تطابق 531 (كان رقمٌ مكتوبٌ قبل القياس 526 فرفضه decide؛ صُحِّح إلى المحسوب). -/
theorem F_without_sifa :
    let rest := fRows.filter (fun r => !(bare r.2.1 == "أفعل" && bare r.2.2 == "فعل"))
    rest.length = 595 ∧ (rest.filter fHit).length = 531 := by decide

/-! ## ٤. فُعْلَة/فِعْلَة ← فُعَل/فِعَل: قانون نسخ الحركة الأولى (وصلٌ داخل الكلمة) -/

def G (sing : String) : Option String :=
  if sing == "فُعلَة" then some "فُعَل" else if sing == "فِعلَة" then some "فِعَل" else none

theorem G_domain : gRows.length = 160 := by decide
theorem G_hits : (gRows.filter (fun r => G r.2.1 == some r.2.2)).length = 136 := by decide

end Ghanem.LexSamai

