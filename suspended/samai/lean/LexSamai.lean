/-
  LexSamai.lean — فكّ ما بقي سماعيًّا بقوانين الابتداء والوصل والوقف: ما يُفكّ وما يمتنع
  Lean 4 core (v4.15.0)، بلا Mathlib، بلا sorry، بلا axiom.
  الجداول مولَّدة آليًّا (gen_lex_lean.py) من معجم «الرموز الوسيط» Arramooz
  (github linuxscout/arramooz، data/nouns/*.csv و data/verbs/verb_triliteral.csv)،
  وأزواج الجمع من lex_plural_pairs.json (sha256 أوّل 16: 037710e9a9897620).
  تنبيه نوع المودَع (المادة ١٢): معجمٌ حديث جُمع يدويًّا لمدقّق إملائي، لا المقاييس ولا سيبويه.
-/
set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace Ghanem.LexSamai

/-! ## ١. مبرهنة عامّة: دالّةٌ تمرّ بإسقاطٍ ثابت ثابتة.
    تصحيح (2026-10-12، CLAIM_ABOVE_ITS_SUPPORT): استُعملت سابقًا للقول إنّ مصدر المجرّد
    «يستحيل فكّه بالقوانين»، على فرضٍ وضعه الوكيل لا المالك: أنّ القوانين ترى الهيكل المقطعيّ (CV) وحده.
    وحدات الـ116 تحمل الحركة، فمدخل القوانين يفرّق فَعَلَ/فَعِلَ/فَعُلَ وأبواب المضارع، فلا ينطبق الفرض.
    المبرهنة صحيحة في ذاتها، ولا تُستعمل حكمًا على المصدر. -/

theorem factor_through_constant {X S Y : Type} (skel : X → S) (s₀ : S)
    (hconst : ∀ x, skel x = s₀) (g : S → Y) :
    ∀ x₁ x₂, g (skel x₁) = g (skel x₂) := by
  intro x₁ x₂; rw [hconst x₁, hconst x₂]

/-! ## ٢. تفعيل أم تفعلة: قانون وصلٍ على لام الكلمة -/

