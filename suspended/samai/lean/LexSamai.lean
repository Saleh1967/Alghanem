/-- قانون الوصل على اللام: لامٌ ياءٌ أو واو لا تقع بعد ياء المدّ (‹تفعييٌ›) ⇒ تفعلة لازمة؛
    والهمزة كذلك تُؤثِر التاء؛ والسالم على تفعيل. -/
def W : RootType → MasdarII
  | .naqis  => .tafila
  | .mahmuz => .tafila
  | .salim  => .tafil

def count (p : String × RootType × MasdarII → Bool) : Nat := (tafRows.filter p).length

theorem taf_total : tafRows.length = 609 := by decide
theorem naqis_all_tafila :
    count (fun r => r.2.1 == .naqis) = 29 ∧ count (fun r => r.2.1 == .naqis && r.2.2 == .tafila) = 29 := by
  decide
theorem mahmuz_split :
    count (fun r => r.2.1 == .mahmuz && r.2.2 == .tafila) = 7 ∧
    count (fun r => r.2.1 == .mahmuz && r.2.2 == .tafil) = 1 := by decide
theorem salim_split :
    count (fun r => r.2.1 == .salim && r.2.2 == .tafil) = 566 ∧
    count (fun r => r.2.1 == .salim && r.2.2 == .tafila) = 6 := by decide
theorem W_hits : count (fun r => W r.2.1 == r.2.2) = 602 := by decide

