    (trans.filter (fun r => r.2.2.2.1 == "معتل" && r.2.1 == "a")).length = 124 ∧
    (trans.filter (fun r => r.2.2.2.1 == "معتل" && r.2.1 == "a" && r.2.2.2.2 == "فعول")).length = 2 := by decide

