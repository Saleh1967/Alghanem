theorem fuul_by_transitivity :
    (trans.filter (fun r => r.2.1 == "a" && r.2.2.1 == "غير مشهود")).length = 427 ∧
    (trans.filter (fun r => r.2.1 == "a" && r.2.2.1 == "غير مشهود" && r.2.2.2.2 == "فعول")).length = 82 ∧
    (trans.filter (fun r => r.2.1 == "a" && r.2.2.1 == "متعد")).length = 376 ∧
    (trans.filter (fun r => r.2.1 == "a" && r.2.2.1 == "متعد" && r.2.2.2.2 == "فعول")).length = 16 := by decide

