def pred : String → List String
  | "داء" => ["فُعَال"]
  | "صوت" => ["فُعَال", "فَعِيل"]
  | "امتناع" => ["فِعَال"]
  | "اضطراب" => ["فَعَلَان"]
  | "سير" => ["فَعِيل"]
  | _ => ["فُعُول"]

def hit (p : List String) (ms : List String) : Bool := p.any (fun x => ms.contains x)

theorem n_rows : rows.length = 112 := by decide
theorem h1_hits : (rows.filter (fun r => hit (pred r.2.2.1) r.2.2.2)).length = 29 := by decide
theorem base_hits : (rows.filter (fun r => hit ["فُعُول"] r.2.2.2)).length = 23 := by decide
theorem const_hits : (rows.filter (fun r => hit ["فَعل"] r.2.2.2)).length = 48 := by decide
/-- قاعدة الحكم المسجَّلة: H1 لا تزيد على الثابت الأغلب ⇒ تُردّ. -/
theorem h1_below_const : 29 < 48 := by decide
/-- الصنف «صوت» وحده: 12 فعلًا، يصيب 11 — نتيجة استكشافية تحتاج تسجيلًا جديدًا. -/
theorem sawt_class :
    (rows.filter (fun r => r.2.2.1 == "صوت")).length = 12 ∧
    (rows.filter (fun r => r.2.2.1 == "صوت" && hit (pred "صوت") r.2.2.2)).length = 11 := by decide

